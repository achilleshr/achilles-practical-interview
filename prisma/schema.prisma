// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model RemoteJob {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title       String
  description String

  RemoteApplications RemoteApplication[]

  @@map("ats_jobs")
}

enum RemoteApplicationStatus {
  REMOTE_APPLIED
  REMOTE_SCREEN
  REMOTE_INTERVIEW
  REMOTE_OFFER
  REMOTE_HIRED
  REMOTE_REJECTED
  REMOTE_NEW_LEAD
  REMOTE_INTERNALLY_SUBMITTED
  REMOTE_CANDIDATE_DECLINED_LOCATION
  REMOTE_INTERVIEWING
  REMOTE_APPROVED
  REMOTE_MAYBE
}

// Local application stages, intentionally a smaller set than the remote statuses.
enum ApplicationStatus {
  APPLIED
  INTERVIEWING
  OFFER
  REJECTED
}

model RemoteApplication {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  status RemoteApplicationStatus @default(REMOTE_APPLIED)

  remoteJobId       String
  remoteCandidateId String

  RemoteJob       RemoteJob       @relation(fields: [remoteJobId], references: [id], onDelete: Cascade)
  RemoteCandidate RemoteCandidate @relation(fields: [remoteCandidateId], references: [id], onDelete: Cascade)

  @@map("ats_applications")
}

model RemoteCandidate {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firstName String
  lastName  String
  email     String

  phoneNumber String
  // IANA time zone, e.g. "America/Chicago". Null when unknown.
  timezone    String?

  remoteApplications RemoteApplication[]

  @@map("ats_candidates")
}

model Job {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title       String
  description String
  remoteId    String?

  companyId String

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applications Application[]

  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([remoteId])
  @@map("jobs")
}

model Application {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  status   ApplicationStatus?
  remoteId String?

  candidateId String
  jobId       String

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job       Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  interviews Interview[]

  @@unique([remoteId])
  @@unique([candidateId, jobId])
  @@map("applications")
}

model Candidate {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firstName String
  lastName  String
  email     String
  remoteId  String?

  phoneNumber String
  // IANA time zone, e.g. "America/Chicago". Null when unknown.
  timezone    String?

  applications Application[]

  interviews Interview[]

  @@unique([remoteId])
  @@map("candidates")
}

model Company {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name String

  jobs Job[]

  locations Location[]

  @@map("companies")
}

// A physical site where candidates interview and work.
model Location {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name        String
  address     String
  // IANA time zone, e.g. "America/Chicago".
  timezone    String
  // E.164 number that texts about this location are sent from.
  phoneNumber String

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  jobs Job[]

  @@unique([phoneNumber])
  @@map("locations")
}

model Interview {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // When the interview starts, in UTC.
  startsAt DateTime

  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("interviews")
}

enum SmsProviderMessageStatus {
  DELIVERED
  FAILED
}

model SmsProviderMessage {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  from   String
  to     String
  body   String
  status SmsProviderMessageStatus

  @@map("sms_provider_messages")
}
